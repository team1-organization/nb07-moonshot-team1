{
  "compilerOptions": {
    /* 경로 설정 */
    "rootDir": "./src", // 실제 코드가 위치할 폴더
    "outDir": "./dist", // 컴파일된 파일이 저장될 폴더

    /* 모듈 및 타겟 설정 */
    "module": "ESNext", // 최신 Node.js 모듈 처리 방식
    "moduleResolution": "Bundler", // 모듈을 찾는 방식 설정
    "target": "ESNext", // 최신 JS 문법으로 변환

    /* 라이브러리 및 타입 설정 */
    "lib" : ["ESNext"], // 사용할 JS 표준 라이브러리
    "types": ["node"], // Node.js 기본 타입 정의 포함

    /* 호환성 및 편의성 */
    "allowImportingTsExtensions": false, // 빌드 결과물을 위해 false 유지
    "resolveJsonModule": true,
    "esModuleInterop": true,       // CommonJS 모듈을 default import로 가져오기 허용 (Express 등)
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true, // 파일명 대소문자 구분 엄격화
    "strict": true, // 엄격한 타입 체크
    "skipLibCheck": true, // 라이브러리 타입 체크 건너뛰기

    /* 5. 기타 설정 유지 */
    "sourceMap": true,        // 에러 발생 시 원본 TS 코드 위치 추적 가능
    "removeComments": true,   // 빌드 결과물에서 주석 제거
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "generate"]
}
